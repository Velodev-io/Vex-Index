# VexIndex Daemon Configuration

# Port and host bindings
VEXINDEX_PORT=8766
VEXINDEX_HOST=127.0.0.1

# SQLite database file path
VEXINDEX_DB_PATH=~/.vexindex/index.db

# Chunker line limits and overlap size
VEXINDEX_MAX_CHUNK_LINES=50
VEXINDEX_CHUNK_OVERLAP_LINES=10

# Directory names to skip when indexing projects
VEXINDEX_SKIP_DIRS=.git,node_modules,__pycache__,.venv,dist,build,.next,target,.pytest_cache,venv

# Embedding configuration
VEXINDEX_EMBED_PROVIDER=ollama
VEXINDEX_EMBED_MODEL=nomic-embed-text
VEXINDEX_EMBED_DIMENSIONS=768
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Vector storage location (used for local vector fallback)
VEXINDEX_VECTOR_PATH=~/.vexindex/vectors

# Qdrant cloud/server vector store integration (optional)
# VEXINDEX_QDRANT_URL=http://localhost:6333
# VEXINDEX_QDRANT_API_KEY=your-qdrant-api-key

# Qdrant HNSW index parameters (applied at collection creation)
VEXINDEX_QDRANT_HNSW_EF=128
VEXINDEX_QDRANT_HNSW_M=16

# Hybrid search merging parameters (weighted Reciprocal Rank Fusion)
VEXINDEX_HYBRID_RRF_K=60
# Weight: 1.0 = pure FTS5, 0.0 = pure vector, 0.6 = hybrid (recommended for code)
VEXINDEX_HYBRID_ALPHA=0.6
VEXINDEX_HYBRID_PROSE_PENALTY=0.3

# Fragments shorter than this (normalised) are ignored in fuzzy substring matching
VEXINDEX_MIN_MATCH_LENGTH=2

# Large file guard: files exceeding this size in KB will be skipped from index (default 1024 = 1MB)
VEXINDEX_MAX_FILE_SIZE_KB=1024
